# MQTT auth service (celine.mqtt_auth, `task run` on :8009). Process environment.
#
# Posture (celine.sdk.posture): CELINE_ENV, then ENVIRONMENT. Only `dev` relaxes;
# unset, prod, staging, test, local, ci or a typo is hardened, and a hardened
# start refuses — listing every finding at once — while any of the three OIDC
# values below is missing. `task run` exports CELINE_ENV=dev.
# CELINE_ENV=dev

# Issuer and JWKS; the SDK defaults both to the local Keycloak, which only dev
# accepts.
# CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
# CELINE_OIDC_JWKS_URI=http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/certs

# The audience every MQTT client token must carry (`aud`). Required outside dev,
# optional in dev, enforced in every environment once set. Without it a token
# issued to ANY client of the realm is an MQTT credential.
#
# The realm has no MQTT audience today: a service's client-credentials token
# carries the audiences of the scopes it holds (e.g. svc-flexibility,
# svc-pipelines), and no value is common to every broker client. An audience
# mapper onto one MQTT audience (a client following the svc-{name} convention)
# has to be added to clients.yaml for every broker client before a hardened
# deployment can set this and still accept them.
# CELINE_OIDC_AUDIENCE=

# CELINE_POLICIES_DIR=./policies
# CELINE_POLICIES_DATA_DIR=
# CELINE_LOG_LEVEL=INFO
